 # Copy this file to ".env" and change the values. ".env" is git-ignored.

# --- database (used by docker-compose) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# --- first administrator (only used when the database has no users yet) ---
HMS_ADMIN_PASSWORD=ChangeMe123

# --- set to false for real deployments (demo receptionist/doctor/patient) ---
HMS_SEED_DEMO=false

# --- set to true when the site is served over HTTPS ---
COOKIE_SECURE=false
